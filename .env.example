# ============================================================================
# AquaFlex AI — Environment Configuration Template
# Problem Statement 5: AI/ML-Based Detection & Mapping of Floating Marine
# Plastic Debris (MSC ELSA 3 Incident Case Study)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed:
#     cp .env.example .env
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=AquaFlex AI
APP_VERSION=1.0.0
APP_DESCRIPTION="Automated Marine Plastic Debris Detection & Predictive Drift Simulation Platform (MSC ELSA 3 Case Study)"
ENVIRONMENT=development

# --- API Server ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the dashboard frontend.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500

# --- Sentinel-2 / Open-Access Satellite Data -------------------------------
# Toggle between live Copernicus Open Access Hub access and deterministic
# synthetic mock tiles (used for offline demos and CI). Set to "true" to
# avoid requiring Copernicus credentials.
USE_MOCK_SATELLITE=true
# Copernicus Data Space Ecosystem credentials (only needed when USE_MOCK_SATELLITE=false).
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Default Sentinel-2 product/bands requested for the debris composite.
SENTINEL2_BANDS=B04,B03,B02,B08

# --- INCOIS Oceanographic / Meteorological Products ------------------------
# Base URL for INCOIS ocean current & wind vector services (OSCAR / MOSDAC).
INCOIS_BASE_URL=https://incois.gov.in
# 3% wind leeway factor applied to surface wind stress in the drift engine.
WIND_LEEWAY_FACTOR=0.03

# --- AI/ML Detection Model -------------------------------------------------
# Path or model id for the Ultralytics YOLOv8 detector.
YOLO_MODEL=yolov8n.pt
# Minimum confidence threshold (0-1) for retaining a debris detection.
DETECTION_CONFIDENCE_THRESHOLD=0.25

# --- Drift Simulation ------------------------------------------------------
# Forecast horizon (hours) for the trajectory projection.
FORECAST_HORIZON_HOURS=72
# Integration timestep in hours for the kinematic drift engine.
DRIFT_TIMESTEP_HOURS=1.0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
